#include <WiFi.h>
#include <WebServer.h>
#include <IRremote.hpp>

#define IR_SEND_PIN 4

// ===== Wi-Fi設定 =====
const char* ssid = "...";
const char* password = "...";

WebServer server(80);

// ===== 赤外線送信 =====
void sendHumidifierON() {
  Serial.println("IR ON");
  IrSender.sendNEC(0x80, 0x1A, 5);
 // ← 実際に動いた値にする
}

void sendHumidifierOFF() {
  Serial.println("IR OFF");
  // OFFコードがあればここに
}

// ===== Web =====
void handleRoot() {
  server.send(200, "text/html",
    "<h1>Humidifier</h1>"
    "<a href='/on'><button>ON</button></a><br><br>"
    "<a href='/off'><button>OFF</button></a>"
  );
}

void handleOn() {
  sendHumidifierON();
  server.send(200, "text/plain", "ON sent");
}

void handleOff() {
  sendHumidifierOFF();
  server.send(200, "text/plain", "OFF sent");
}

void setup() {
  Serial.begin(115200);

  // Wi-Fi
  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println();
  Serial.print("IP: ");
  Serial.println(WiFi.localIP());

  // Web
  server.on("/", handleRoot);
  server.on("/on", handleOn);
  server.on("/off", handleOff);
  server.begin();

  // IR送信開始
  IrSender.begin(IR_SEND_PIN);

  Serial.println("Ready");
}

void loop() {
  server.handleClient();
}
